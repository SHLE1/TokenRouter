[Unit]
Description=TokenRouter Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=tokenrouter
Group=tokenrouter
WorkingDirectory=/opt/tokenrouter
ExecStart=/opt/tokenrouter/datamanagementd \
  -socket-path /tmp/tokenrouter-datamanagement.sock \
  -sqlite-path /var/lib/tokenrouter/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
